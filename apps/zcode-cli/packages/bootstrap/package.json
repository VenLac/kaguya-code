{
  "name": "@zcode/bootstrap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./v4-replay": {
      "types": "./dist/zcode-protocol-v4/replay.d.ts",
      "import": "./dist/zcode-protocol-v4/replay.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "node ../../scripts/clean-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test:permission": "node --import tsx --test test/external-permission-broker.test.ts",
    "test:plugin-reference": "node --import tsx --test test/plugin-reference-catalog.test.ts",
    "lint": "oxlint src",
    "lint:fix": "oxlint --write src"
  },
  "dependencies": {
    "@zcode/adapters": "workspace:*",
    "@zcode/contracts": "workspace:*",
    "@zcode/core": "workspace:*",
    "@zcode/dynamic-workflow": "workspace:*",
    "@zcode/dynamic-workflow-runtime": "workspace:*",
    "@zcode/i18n": "workspace:*",
    "@zcode/provider": "workspace:*",
    "@zcode/provider-node": "workspace:*",
    "@zcode/shared": "workspace:*",
    "@zcode/telemetry": "workspace:*",
    "diff": "^9.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/yazl": "^3.3.1",
    "@zcode/formal-proof": "workspace:*",
    "yazl": "^3.3.1"
  }
}
